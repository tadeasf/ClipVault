import cz.tadeasf.clipvault.detect.SensitiveCategory;
import cz.tadeasf.clipvault.model.ContentType;
import kotlin.Boolean;
import kotlin.collections.Set;

-- Column order matches the domain Clip constructor, so queries map with ::Clip.
-- seq, categories and sourcePackage are last because migrations 1-3 add them with ALTER TABLE (which appends).
-- categories: comma-separated SensitiveCategory names, empty when the clip is not sensitive.
CREATE TABLE Clip (
  id TEXT NOT NULL PRIMARY KEY,
  deviceId TEXT NOT NULL,
  createdAt INTEGER NOT NULL,
  contentType TEXT AS ContentType NOT NULL,
  contentHash TEXT NOT NULL,
  content TEXT NOT NULL,
  sensitive INTEGER AS Boolean NOT NULL,
  pinned INTEGER AS Boolean NOT NULL DEFAULT 0,
  deleted INTEGER AS Boolean NOT NULL DEFAULT 0,
  lamportClock INTEGER NOT NULL,
  seq INTEGER NOT NULL DEFAULT 0,
  categories TEXT AS Set<SensitiveCategory> NOT NULL DEFAULT '',
  sourcePackage TEXT
);

CREATE INDEX clip_list ON Clip(deleted, pinned, createdAt);
CREATE INDEX clip_hash ON Clip(contentHash);
CREATE UNIQUE INDEX clip_seq ON Clip(seq);

-- One counter for clip writes and MetaEvents (design 5.1). Bumped with UPDATE first inside the
-- write transaction, so SQLite's write lock makes it race-free.
CREATE TABLE SeqCounter (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
  value INTEGER NOT NULL
);

INSERT INTO SeqCounter(id, value) VALUES (1, 0);

-- Two full-text indexes keyed by Clip.rowid: trigram for substring search (queries >= 3 chars),
-- unicode61 for word-prefix search of shorter tokens. Both fold diacritics ("kod" finds "kód").
CREATE VIRTUAL TABLE ClipFts USING fts5(content, tokenize = 'trigram remove_diacritics 1');
CREATE VIRTUAL TABLE ClipFtsPrefix USING fts5(content);

CREATE TRIGGER clip_fts_insert AFTER INSERT ON Clip BEGIN
  INSERT INTO ClipFts(rowid, content) VALUES (new.rowid, new.content);
  INSERT INTO ClipFtsPrefix(rowid, content) VALUES (new.rowid, new.content);
END;

CREATE TRIGGER clip_fts_delete AFTER DELETE ON Clip BEGIN
  DELETE FROM ClipFts WHERE rowid = old.rowid;
  DELETE FROM ClipFtsPrefix WHERE rowid = old.rowid;
END;

-- Delete + insert: `UPDATE ClipFts SET content = new.content` overflows SQLDelight 2.4.1's resolver.
CREATE TRIGGER clip_fts_update AFTER UPDATE OF content ON Clip BEGIN
  DELETE FROM ClipFts WHERE rowid = old.rowid;
  INSERT INTO ClipFts(rowid, content) VALUES (new.rowid, new.content);
  DELETE FROM ClipFtsPrefix WHERE rowid = old.rowid;
  INSERT INTO ClipFtsPrefix(rowid, content) VALUES (new.rowid, new.content);
END;

bumpSeq:
UPDATE SeqCounter SET value = value + 1 WHERE id = 1;

currentSeq:
SELECT value FROM SeqCounter WHERE id = 1;

insert:
INSERT INTO Clip(id, deviceId, createdAt, contentType, contentHash, content, sensitive, lamportClock, seq, categories, sourcePackage)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectById:
SELECT * FROM Clip WHERE id = ?;

findLiveByHash:
SELECT id FROM Clip WHERE contentHash = ? AND deleted = 0 LIMIT 1;

-- A re-copied clip gets a new seq so catch-up delivers the bump.
touch:
UPDATE Clip SET createdAt = :createdAt, seq = :seq WHERE id = :id;

-- A row's state is recomputed from its members (ClipLog.refold).
setGroupState:
UPDATE Clip SET pinned = :pinned, deleted = :deleted, createdAt = :createdAt WHERE id = :id;

setSensitivity:
UPDATE Clip SET sensitive = :sensitive, categories = :categories WHERE id = :id;

-- A clip synced without its payload (over the cap) has '' content and its real hash until fetched.
fillContent:
UPDATE Clip SET content = :content WHERE id = :id AND content = '' AND contentHash = :contentHash;

-- A deleted clip keeps its row (tombstone for sync) but loses its content.
wipeContent:
UPDATE Clip SET content = '', contentHash = '' WHERE id = ?;

-- includeSensitive = 1 matches both values of `sensitive`; 0 matches only non-sensitive rows.
-- List filters: includeSensitive = 1 matches both values of `sensitive`, 0 only non-sensitive rows;
-- pinnedOnly = 1 keeps pinned rows only (pinned >= 1); type NULL means any content type.
countLive:
SELECT count(*) FROM Clip
WHERE deleted = 0 AND (sensitive = 0 OR sensitive = :includeSensitive)
  AND pinned >= :pinnedOnly AND (:type IS NULL OR contentType = :type);

page:
SELECT * FROM Clip
WHERE deleted = 0 AND (sensitive = 0 OR sensitive = :includeSensitive)
  AND pinned >= :pinnedOnly AND (:type IS NULL OR contentType = :type)
ORDER BY pinned DESC, createdAt DESC
LIMIT :limit OFFSET :offset;

countSearchTrigram:
SELECT count(*) FROM Clip
JOIN ClipFts ON ClipFts.rowid = Clip.rowid
WHERE ClipFts MATCH :query AND Clip.deleted = 0 AND (Clip.sensitive = 0 OR Clip.sensitive = :includeSensitive)
  AND Clip.pinned >= :pinnedOnly AND (:type IS NULL OR Clip.contentType = :type);

searchTrigram:
SELECT Clip.* FROM Clip
JOIN ClipFts ON ClipFts.rowid = Clip.rowid
WHERE ClipFts MATCH :query AND Clip.deleted = 0 AND (Clip.sensitive = 0 OR Clip.sensitive = :includeSensitive)
  AND Clip.pinned >= :pinnedOnly AND (:type IS NULL OR Clip.contentType = :type)
ORDER BY Clip.pinned DESC, Clip.createdAt DESC
LIMIT :limit OFFSET :offset;

countSearchPrefix:
SELECT count(*) FROM Clip
JOIN ClipFtsPrefix ON ClipFtsPrefix.rowid = Clip.rowid
WHERE ClipFtsPrefix MATCH :query AND Clip.deleted = 0 AND (Clip.sensitive = 0 OR Clip.sensitive = :includeSensitive)
  AND Clip.pinned >= :pinnedOnly AND (:type IS NULL OR Clip.contentType = :type);

searchPrefix:
SELECT Clip.* FROM Clip
JOIN ClipFtsPrefix ON ClipFtsPrefix.rowid = Clip.rowid
WHERE ClipFtsPrefix MATCH :query AND Clip.deleted = 0 AND (Clip.sensitive = 0 OR Clip.sensitive = :includeSensitive)
  AND Clip.pinned >= :pinnedOnly AND (:type IS NULL OR Clip.contentType = :type)
ORDER BY Clip.pinned DESC, Clip.createdAt DESC
LIMIT :limit OFFSET :offset;

countAll:
SELECT count(*) FROM Clip WHERE deleted = 0;

countSensitive:
SELECT count(*) FROM Clip WHERE deleted = 0 AND sensitive = 1;

-- Retention is a local policy: rows are removed outright, not tombstoned, and pinned clips are exempt.
deleteOlderThan:
DELETE FROM Clip WHERE pinned = 0 AND createdAt < ?;

deleteSensitiveOlderThan:
DELETE FROM Clip WHERE pinned = 0 AND sensitive = 1 AND createdAt < ?;

keepNewest:
DELETE FROM Clip WHERE pinned = 0 AND id NOT IN (
  SELECT id FROM Clip WHERE pinned = 0 ORDER BY createdAt DESC LIMIT ?
);
