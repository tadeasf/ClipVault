import cz.tadeasf.clipvault.model.MetaField;
import kotlin.Boolean;

-- Append-only metadata log (design 5.1). seq comes from SeqCounter, shared with Clip; AUTOINCREMENT
-- stays only because changing it would need a table rebuild.
CREATE TABLE MetaEvent (
  seq INTEGER PRIMARY KEY AUTOINCREMENT,
  clipId TEXT NOT NULL,
  field TEXT AS MetaField NOT NULL,
  value INTEGER AS Boolean NOT NULL,
  lamportClock INTEGER NOT NULL,
  deviceId TEXT NOT NULL
);

CREATE INDEX meta_clip ON MetaEvent(clipId);
CREATE UNIQUE INDEX meta_unique ON MetaEvent(clipId, field, value, lamportClock, deviceId);

insert:
INSERT INTO MetaEvent(seq, clipId, field, value, lamportClock, deviceId) VALUES (?, ?, ?, ?, ?, ?);

forClip:
SELECT clipId, field, value, lamportClock, deviceId FROM MetaEvent WHERE clipId = ?;

-- clipId names a ClipMember. Orphaned deletes are kept, so a deleted clip that arrives again later stays deleted.
deleteOrphans:
DELETE FROM MetaEvent WHERE field != 'DELETED' AND clipId NOT IN (SELECT id FROM ClipMember);

exists:
SELECT count(*) FROM MetaEvent WHERE clipId = ? AND field = ? AND value = ? AND lamportClock = ? AND deviceId = ?;

after:
SELECT * FROM MetaEvent WHERE seq > :since ORDER BY seq LIMIT :limit;
